.loading-box,
.error-box {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.share-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.share-card {
  width: 48%;
  margin-bottom: 20rpx;
}

.share-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.share-body {
  padding: 16rpx 20rpx 20rpx;
}

.share-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.share-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.share-text {
  font-size: 26rpx;
  color: #2c2c2c;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.share-stats {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #999;
}
