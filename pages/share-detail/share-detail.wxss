.detail-img {
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.detail-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid #fef0ec;
}

.detail-nickname {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.detail-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #2c2c2c;
  margin-bottom: 20rpx;
  display: block;
}

.detail-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  background: #fff;
  font-size: 28rpx;
}

.action-btn.active-like {
  border-color: #e07a5f;
  background: #fef0ec;
  color: #c4603f;
}

.action-btn.active-collect {
  border-color: #d4a574;
  background: #fdf6f0;
  color: #b8845a;
}

.comments-section {
  border-top: 2rpx solid #eee;
  padding-top: 24rpx;
}

.section-sub {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.comment-input {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  align-items: center;
}

.comment-input .form-input {
  flex: 1;
  min-width: 0;
  width: auto;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2c2c;
  display: block;
}

.comment-text {
  font-size: 28rpx;
  color: #666;
  margin: 6rpx 0;
  line-height: 1.5;
  display: block;
}

.comment-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-time {
  font-size: 20rpx;
  color: #999;
}

.reply-btn {
  font-size: 22rpx;
  color: #e07a5f;
}

.reply-input {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  align-items: center;
}

.reply-input .form-input {
  flex: 1;
  min-width: 0;
  width: auto;
}

.reply-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f7f8f9;
  border-radius: 10rpx;
}

.reply-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.reply-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #c4603f;
  margin-right: 8rpx;
}

.reply-text-content {
  font-size: 24rpx;
  color: #666;
}
