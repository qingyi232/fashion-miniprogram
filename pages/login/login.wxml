<view class="login-page">
  <view class="login-card">
    <view class="login-brand">
      <text class="brand-icon">👗</text>
      <text class="brand-title">衣搭</text>
      <text class="brand-desc">智能穿搭助手 · 发现你的风格</text>
    </view>
    <view class="login-form card">
      <text class="form-title">选择身份登录</text>
      <view class="user-list">
        <view class="user-option" wx:for="{{users}}" wx:key="openid" bindtap="doLogin" data-openid="{{item.openid}}">
          <image src="{{item.avatar}}" class="user-avatar"></image>
          <view class="user-info">
            <text class="user-name">{{item.name}}</text>
            <text class="user-role">{{item.roleLabel}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
