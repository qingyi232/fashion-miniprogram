<view class="container">
  <view class="page-header">
    <view class="title">系统管理</view>
    <view class="desc">平台公告、反馈处理、日志查看</view>
  </view>

  <!-- 公告管理 -->
  <view class="system-section">
    <view class="section-header">
      <text class="section-sub">公告管理</text>
      <view class="btn btn-sm btn-primary" bindtap="showAnnouncementForm">+ 发布公告</view>
    </view>
    <view class="item-list">
      <view class="item-card card" wx:for="{{announcements}}" wx:key="id">
        <text class="item-title">{{item.title}}</text>
        <text class="item-content">{{item.content}}</text>
        <view class="item-footer">
          <text class="item-time">{{item.created_at}}</text>
          <view class="btn btn-sm btn-ghost" style="color:#d4726a" bindtap="deleteAnnouncement" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 反馈处理 -->
  <view class="system-section">
    <text class="section-sub">用户反馈</text>
    <view class="item-list">
      <view class="item-card card" wx:for="{{feedbacks}}" wx:key="id">
        <view class="feedback-header">
          <text class="tag {{item.type === 'suggestion' ? '' : 'tag-pink'}}">{{item.type === 'suggestion' ? '建议' : '投诉'}}</text>
          <text class="tag {{item.reply ? 'tag-green' : ''}}">{{item.reply ? '已回复' : '待处理'}}</text>
        </view>
        <text class="item-content">{{item.content}}</text>
        <view wx:if="{{item.reply}}" class="reply-box">
          <text class="reply-label">回复：</text>
          <text>{{item.reply}}</text>
        </view>
        <view wx:else class="reply-action">
          <input class="form-input" style="flex:1" placeholder="输入回复..." bindinput="onReplyInput" data-id="{{item.id}}" />
          <view class="btn btn-sm btn-primary" bindtap="replyFeedback" data-item="{{item}}">回复</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 系统日志 -->
  <view class="system-section">
    <text class="section-sub">系统日志</text>
    <view class="item-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="id">
        <text class="log-time">{{item.created_at}}</text>
        <text class="log-action">{{item.action}}</text>
        <text class="log-detail">{{item.detail}}</text>
      </view>
    </view>
  </view>

  <!-- 发布公告弹窗 -->
  <view class="modal-mask" wx:if="{{showAnnForm}}" bindtap="hideAnnouncementForm">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">发布公告</view>
      <view class="form-group">
        <text class="form-label">标题</text>
        <input class="form-input" value="{{annForm.title}}" bindinput="onAnnInput" data-field="title" placeholder="公告标题" />
      </view>
      <view class="form-group">
        <text class="form-label">内容</text>
        <textarea class="form-textarea" value="{{annForm.content}}" bindinput="onAnnInput" data-field="content" placeholder="公告内容..."></textarea>
      </view>
      <view class="modal-actions">
        <view class="btn btn-ghost" bindtap="hideAnnouncementForm">取消</view>
        <view class="btn btn-primary" bindtap="submitAnnouncement">发布</view>
      </view>
    </view>
  </view>
</view>
