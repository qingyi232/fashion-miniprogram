<view class="container">
  <view class="page-header">
    <view class="title">管理后台</view>
    <view class="desc">数据概览</view>
  </view>

  <!-- 统计卡片 -->
  <view class="admin-stats">
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#fef0ec;color:#c4603f">👥</text>
      <view>
        <text class="a-stat-num">{{stats.totalUsers || 0}}</text>
        <text class="a-stat-label">注册用户</text>
      </view>
    </view>
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#fdf2f4;color:#e8a0bf">👚</text>
      <view>
        <text class="a-stat-num">{{stats.totalClothes || 0}}</text>
        <text class="a-stat-label">衣物总量</text>
      </view>
    </view>
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#edf7f0;color:#6db884">✨</text>
      <view>
        <text class="a-stat-num">{{stats.totalOutfits || 0}}</text>
        <text class="a-stat-label">搭配方案</text>
      </view>
    </view>
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#eef0ff;color:#6c7ae0">📸</text>
      <view>
        <text class="a-stat-num">{{stats.totalShares || 0}}</text>
        <text class="a-stat-label">穿搭分享</text>
      </view>
    </view>
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#fff3e6;color:#e6a23c">📋</text>
      <view>
        <text class="a-stat-num">{{stats.pendingReviews || 0}}</text>
        <text class="a-stat-label">待审核</text>
      </view>
    </view>
    <view class="a-stat-card card">
      <text class="a-stat-icon" style="background:#fde8e8;color:#d4726a">💬</text>
      <view>
        <text class="a-stat-num">{{stats.pendingFeedbacks || 0}}</text>
        <text class="a-stat-label">待处理反馈</text>
      </view>
    </view>
  </view>

  <!-- 管理入口 -->
  <view class="admin-nav">
    <navigator url="/pages/admin/users" class="admin-nav-item card">
      <text class="nav-icon">👥</text><text>用户管理</text>
    </navigator>
    <navigator url="/pages/admin/reviews" class="admin-nav-item card">
      <text class="nav-icon">📋</text><text>内容审核</text>
    </navigator>
    <navigator url="/pages/admin/system" class="admin-nav-item card">
      <text class="nav-icon">⚙️</text><text>系统管理</text>
    </navigator>
    <navigator url="/pages/home/home" open-type="switchTab" class="admin-nav-item card">
      <text class="nav-icon">🏠</text><text>返回前台</text>
    </navigator>
  </view>

  <!-- 最近注册用户 -->
  <view class="card" style="padding:24rpx;margin-top:24rpx" wx:if="{{stats.recentUsers.length}}">
    <text class="chart-title">最近注册用户</text>
    <view class="user-table">
      <view class="table-row table-header">
        <text class="th">头像</text>
        <text class="th" style="flex:2">昵称</text>
        <text class="th">性别</text>
        <text class="th" style="flex:2">注册时间</text>
      </view>
      <view class="table-row" wx:for="{{stats.recentUsers}}" wx:key="id">
        <image src="{{item.avatar}}" class="table-avatar"></image>
        <text class="td" style="flex:2">{{item.nickname}}</text>
        <text class="td">{{item.gender || '-'}}</text>
        <text class="td" style="flex:2">{{item.created_at}}</text>
      </view>
    </view>
  </view>
</view>
