.system-section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-sub {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  padding: 24rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-time {
  font-size: 22rpx;
  color: #999;
}

.feedback-header {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.tag-green {
  background: #edf7f0 !important;
  color: #6db884 !important;
}

.tag-pink {
  background: #fdf2f4 !important;
  color: #e8a0bf !important;
}

.reply-box {
  background: #f7f8f9;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.reply-label {
  font-weight: 600;
  color: #c4603f;
}

.reply-action {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
  align-items: center;
}

.reply-action .form-input {
  flex: 1;
  min-width: 0;
  width: auto;
}

.log-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  font-size: 24rpx;
}

.log-time {
  color: #999;
  flex-shrink: 0;
  width: 200rpx;
}

.log-action {
  color: #e07a5f;
  font-weight: 500;
  flex-shrink: 0;
}

.log-detail {
  color: #666;
  flex: 1;
}
