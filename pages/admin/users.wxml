<view class="container">
  <view class="page-header">
    <view class="title">用户管理</view>
    <view class="desc">管理平台注册用户</view>
  </view>

  <view class="user-list">
    <view class="user-card card" wx:for="{{users}}" wx:key="id">
      <view class="user-row">
        <image src="{{item.avatar}}" class="user-avatar"></image>
        <view class="user-info">
          <text class="user-name">{{item.nickname}}</text>
          <text class="user-meta">{{item.gender || '-'}} · {{item.phone || '未绑定手机'}} · {{item.created_at}}</text>
        </view>
        <view class="status-badge {{item.status === 'active' ? 'active' : 'disabled'}}">{{item.status === 'active' ? '正常' : '禁用'}}</view>
      </view>
      <view class="user-actions">
        <view class="btn btn-sm {{item.status === 'active' ? 'btn-outline' : 'btn-primary'}}" 
          bindtap="toggleStatus" data-item="{{item}}">
          {{item.status === 'active' ? '禁用' : '启用'}}
        </view>
      </view>
    </view>
  </view>
</view>
