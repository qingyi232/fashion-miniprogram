.admin-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.a-stat-card {
  width: 48% !important;
  margin-bottom: 16rpx;
  display: flex !important;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.a-stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.a-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c2c2c;
  display: block;
}

.a-stat-label {
  font-size: 24rpx;
  color: #666;
}

.admin-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.admin-nav-item {
  width: 48% !important;
  margin-bottom: 16rpx;
  display: flex !important;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.nav-icon {
  font-size: 36rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.user-table {
  display: flex;
  flex-direction: column;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.table-header {
  border-bottom: 2rpx solid #eee;
  background: #f7f8f9;
  padding: 16rpx 0;
}

.th {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.td {
  flex: 1;
  font-size: 26rpx;
}

.table-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex: 1;
}
