.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  padding: 16rpx 36rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 3rpx solid #eee;
  background: #fff;
  color: #666;
}

.mode-tab.active {
  background: #d4a574;
  color: #fff;
  border-color: #d4a574;
}

.match-panel {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.match-panel .form-row {
  gap: 24rpx;
}

.match-panel .form-group picker {
  width: 100%;
  display: block;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.sub-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.schemes {
  margin-bottom: 32rpx;
}

.scheme-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.scheme-header {
  margin-bottom: 16rpx;
}

.scheme-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.scheme-tags {
  display: flex;
  gap: 10rpx;
}

.scheme-items {
  display: flex;
  white-space: nowrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.scheme-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  flex-shrink: 0;
}

.scheme-item image {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.scheme-item text {
  font-size: 22rpx;
  color: #666;
}

.scheme-actions {
  display: flex;
  gap: 12rpx;
}

.filter-select {
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  background: #fff;
  font-size: 26rpx;
}

.manual-clothes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.manual-cloth {
  position: relative;
  width: calc(33.33% - 8rpx);
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid #eee;
}

.manual-cloth.selected {
  border-color: #d4a574;
  box-shadow: 0 0 0 3rpx #fdf6f0;
}

.manual-cloth image {
  width: 100%;
  height: 160rpx;
}

.manual-cloth text {
  display: block;
  font-size: 22rpx;
  padding: 6rpx 8rpx;
  text-align: center;
  color: #666;
}

.check-mark {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #d4a574;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-area {
  padding: 24rpx;
}

.preview-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f7f8f9;
}

.preview-item image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
}

.preview-info {
  flex: 1;
}

.preview-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}

.preview-cat {
  font-size: 22rpx;
  color: #999;
}

.remove-btn {
  width: 40rpx;
  height: 40rpx;
  background: rgba(212,114,106,0.1);
  color: #d4726a;
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.saved-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.saved-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.saved-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.tag-green {
  background: #edf7f0 !important;
  color: #6db884 !important;
}

.tag-pink {
  background: #fdf2f4 !important;
  color: #e8a0bf !important;
}

.tag-blue {
  background: #eef0ff !important;
  color: #6c7ae0 !important;
}

.saved-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}
