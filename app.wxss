page {
  --accent: #d4a574;
  --accent-dark: #b8845a;
  --accent-light: #fdf6f0;
  --text: #2d2926;
  --text2: #6b6462;
  --text3: #a09896;
  --bg: #faf9f7;
  --card: #ffffff;
  --border: #f0ebe6;
  --red: #c45b52;
  --green: #7bb88a;
  --green-light: #f0f7f2;
  --pink: #d4899e;
  --pink-light: #fdf2f5;
  --radius: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: #faf9f7;
  color: #2d2926;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 1.5;
}

.btn-primary {
  background: linear-gradient(135deg, #d4a574, #c48d5c);
  color: #fff;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid #d4a574;
  color: #b8845a;
}

.btn-ghost {
  background: transparent;
  color: #666;
}

.btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.btn-block {
  display: flex;
  width: 100%;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #fdf6f0;
  color: #b8845a;
}

.mini-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #fdf6f0;
  color: #b8845a;
}

.page-header {
  padding: 24rpx 0 32rpx;
}

.page-header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c2c2c;
}

.page-header .desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 8rpx;
  color: #2c2c2c;
}

.section-line {
  width: 60rpx;
  height: 6rpx;
  background: #e07a5f;
  border-radius: 3rpx;
  margin: 16rpx auto 40rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 16rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f7f8f9;
  min-height: 72rpx;
  line-height: 40rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.form-input:focus {
  border-color: #e07a5f;
}

.form-textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f7f8f9;
  height: 160rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-group {
  flex: 1;
  min-width: 0;
  margin-right: 0;
}

.form-row .form-group picker {
  width: 100%;
  display: block;
}

.form-row .form-group picker .form-input {
  width: 100%;
}

.modal-actions {
  display: flex;
  margin-top: 32rpx;
  justify-content: flex-end;
}

.modal-actions .btn {
  margin-left: 16rpx;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-2 > view {
  width: 48%;
  margin-bottom: 16rpx;
}
